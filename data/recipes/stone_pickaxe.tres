[gd_resource type="Resource" script_class="RecipeDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/recipes/recipe_definition.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/data/recipes/recipe_ingredient.gd" id="2_ingredient"]
[ext_resource type="Resource" path="res://data/items/stick.tres" id="3_stick"]
[ext_resource type="Resource" path="res://data/items/stone.tres" id="4_stone"]
[ext_resource type="Resource" path="res://data/items/stone_pickaxe.tres" id="5_output"]

[sub_resource type="Resource" id="Ingredient_stick"]
script = ExtResource("2_ingredient")
item_definition = ExtResource("3_stick")
quantity = 2

[sub_resource type="Resource" id="Ingredient_stone"]
script = ExtResource("2_ingredient")
item_definition = ExtResource("4_stone")
quantity = 3

[resource]
script = ExtResource("1_recipe")
recipe_id = &"stone_pickaxe"
display_name = "Stone Pickaxe"
description = "A first-tier pickaxe for mining stone."
category = &"tools"
ingredients = Array[Resource]([SubResource("Ingredient_stick"), SubResource("Ingredient_stone")])
output_item = ExtResource("5_output")
output_quantity = 1
crafting_time_seconds = 1.75
