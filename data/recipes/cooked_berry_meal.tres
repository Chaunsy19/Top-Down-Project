[gd_resource type="Resource" script_class="RecipeDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/recipes/recipe_definition.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/data/recipes/recipe_ingredient.gd" id="2_ingredient"]
[ext_resource type="Resource" path="res://data/items/berries.tres" id="3_berries"]
[ext_resource type="Resource" path="res://data/items/cooked_berry_meal.tres" id="4_output"]

[sub_resource type="Resource" id="Ingredient_berries"]
script = ExtResource("2_ingredient")
item_definition = ExtResource("3_berries")
quantity = 3

[resource]
script = ExtResource("1_recipe")
recipe_id = &"cooked_berry_meal"
display_name = "Cooked Berry Meal"
description = "Cook berries into a warm, simple meal."
category = &"food"
ingredients = Array[Resource]([SubResource("Ingredient_berries")])
output_item = ExtResource("4_output")
output_quantity = 1
crafting_time_seconds = 1.0
required_workstation_tags = Array[StringName]([&"campfire"])
